    { "type": "set", "collection": "nodes", "id": "vn_t_proc", "value": { "id": "vn_t_proc", "viewId": "vw_trace", "elementId": "el_proc", "x": 340, "y": 40, "w": 180, "h": 60 } },
    { "type": "set", "collection": "nodes", "id": "vn_t_abrir", "value": { "id": "vn_t_abrir", "viewId": "vw_trace", "elementId": "el_abrir", "x": 40, "y": 180, "w": 180, "h": 60 } },
    { "type": "set", "collection": "nodes", "id": "vn_t_svc", "value": { "id": "vn_t_svc", "viewId": "vw_trace", "elementId": "el_svc", "x": 340, "y": 180, "w": 180, "h": 60 } },
